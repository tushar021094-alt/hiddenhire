{
  "name": "hiddenhire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --import tsx --test $(grep -L 'from \"vitest\"' tests/*.test.ts)",
    "test:vitest": "vitest run $(grep -l 'from \"vitest\"' tests/*.test.ts)"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "lucide-react": "1.47.0",
    "next": "16.3.8",
    "openai": "7.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
